# Configurações da aplicação
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Configurações JWT
JWT_SECRET=seu_jwt_secret_super_secreto_aqui
JWT_EXPIRES_IN=7d

# Configurações do banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gestao_publica

# Configurações de CORS
CORS_ORIGIN=http://localhost:3000

# Configurações de rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Configurações de logs
LOG_LEVEL=debug

# Configurações de integração
SIAFIC_URL=https://api.siafic.gov.br
SICONFI_URL=https://apidatalake.tesouro.gov.br
PNCP_URL=https://api.gov.br/pncp
ESOCIAL_URL=https://api.esocial.gov.br

# Configurações de email (para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app